<div class="product-slider-wrapper site-wrapper">
  <div class="product-slider">
    {% for block in section.blocks %}
    {% case block.type %}
    {% when 'product' %}
      {% assign product = block.settings.product %}
      {% if product %}
       {% include 'product-grid-item' %}
      {% endif %}
    {% endcase %}
    {% endfor %}
  </div>
</div>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js"></script>
<!-- new 1 -->
<ins class="adsbygoogle"
     style="display:block"
     data-ad-client="ca-pub-2117859206272045"
     data-ad-slot="6726236749"
     data-ad-format="horizontal"
     data-full-width-responsive="false"></ins>
<script>
     (adsbygoogle = window.adsbygoogle || []).push({});
</script>
<footer class="site-footer" role="contentinfo" data-section-id="{{ section.id }}" data-section-type="footer-section">

  <div class="grid">

    {% case section.blocks.size %}
    {% when 0 %}
    {% when 1 %}
    {% assign column_width = 'text-left' %}
    {% when 2 %}
    {% assign column_width = 'medium-up--one-half small--one-whole' %}
    {% when 3 %}
    {% assign column_width = 'medium-up--one-third small--one-whole' %}
    {% when 4 %}
    {% assign column_width = 'medium-up--one-quarter small--one-whole' %}
    {% endcase %}

    {% for block in section.blocks %}
    {% case block.type %}
    {% when 'menu' %}
    <div class="grid__item {{ column_width }}">
      {% if block.settings.title %}
      <h3 class="site-footer__section-title">{{ block.settings.title | escape }}</h3>
      {% endif %}
      <ul class="site-footer__menu">
        {% for link in linklists[block.settings.menu].links %}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </div>

    {% when 'text' %}
    <div class="grid__item {{ column_width }}">
      {% if block.settings.title %}
      <h3 class="site-footer__section-title">{{ block.settings.title | escape }}</h3>
      {% endif %}
      <div class="rte">{{ block.settings.richtext }}</div>
    </div>

    {% comment %} Adjusted by Salvatore D @ Shopify Theme Support on July 31, 2019 {% endcomment %}
    {% when 'social' %}
    <div class="grid__item medium-up--one-whole small--one-whole">
      {% if block.settings.title %}
      <h3 class="site-footer__section-title">{{ block.settings.title | escape }}</h3>
      {% endif %}
      <div class="custom_social grid">
        {% if block.settings.footer_logo_1 != blank %}
        <div class="footer-logo grid__item one-half">
          {% if block.settings.footer_logo_1_url != blank %}
          <a href="{{ block.settings.footer_logo_1_url }}">
            {% endif %}
            <img class="footer-logo-width" src="{{ block.settings.footer_logo_1 | img_url: '300x300' }}"
                 data-src="{{ img_url }}"
                 data-widths="[360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                 data-aspectratio="{{ block.settings.footer_logo_1.aspect_ratio }}"
                 data-sizes="auto"
                 alt="{{ block.settings.footer_logo_1.alt | escape }}">
            {% if block.settings.footer_logo_1_url != blank %}
          </a>
          {% endif %}
        </div>
        {% endif %}
        {% if block.settings.footer_logo_2 != blank %}
        <div class="footer-logo grid__item one-half">
          {% if block.settings.footer_logo_2_url != blank %}
          <a href="{{ block.settings.footer_logo_2_url }}">
            {% endif %}
            <img class="footer-logo-width" src="{{ block.settings.footer_logo_2 | img_url: '300x300' }}"
                 data-src="{{ img_url }}"
                 data-widths="[360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                 data-aspectratio="{{ block.settings.footer_logo_2.aspect_ratio }}"
                 data-sizes="auto"
                 alt="{{ block.settings.footer_logo_2.alt | escape }}">
            {% if block.settings.footer_logo_2_url != blank %}
          </a>
          {% endif %}
        </div>
        {% endif %}
        {% if block.settings.footer_logo_3 != blank %}
        <div class="footer-logo grid__item one-half">
          {% if block.settings.footer_logo_3_url != blank %}
          <a href="{{ block.settings.footer_logo_3_url }}">
            {% endif %}
            <img class="footer-logo-width" src="{{ block.settings.footer_logo_3 | img_url: '300x300' }}"
                 data-src="{{ img_url }}"
                 data-widths="[360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                 data-aspectratio="{{ block.settings.footer_logo_3.aspect_ratio }}"
                 data-sizes="auto"
                 alt="{{ block.settings.footer_logo_3.alt | escape }}">
            {% if block.settings.footer_logo_3_url != blank %}
          </a>
          {% endif %}
        </div>
        {% endif %}
        {% if block.settings.footer_logo_4 != blank %}
        <div class="footer-logo grid__item one-half">
          {% if block.settings.footer_logo_4_url != blank %}
          <a href="{{ block.settings.footer_logo_4_url }}">
            {% endif %}
            <img class="footer-logo-width" src="{{ block.settings.footer_logo_4 | img_url: '300x300' }}"
                 data-src="{{ img_url }}"
                 data-widths="[360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                 data-aspectratio="{{ block.settings.footer_logo_4.aspect_ratio }}"
                 data-sizes="auto"
                 alt="{{ block.settings.footer_logo_4.alt | escape }}">
            {% if block.settings.footer_logo_4_url != blank %}
          </a>
          {% endif %}
        </div>
        {% endif %}
        {% if block.settings.footer_logo_5 != blank %}
        <div class="footer-logo grid__item one-half">
          {% if block.settings.footer_logo_5_url != blank %}
          <a href="{{ block.settings.footer_logo_5_url }}">
            {% endif %}
            <img class="footer-logo-width" src="{{ block.settings.footer_logo_5 | img_url: '300x300' }}"
                 data-src="{{ img_url }}"
                 data-widths="[360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                 data-aspectratio="{{ block.settings.footer_logo_5.aspect_ratio }}"
                 data-sizes="auto"
                 alt="{{ block.settings.footer_logo_5.alt | escape }}">
            {% if block.settings.footer_logo_5_url != blank %}
          </a>
          {% endif %}
        </div>
        {% endif %}
        {% if block.settings.footer_logo_6 != blank %}
        <div class="footer-logo grid__item one-half">
          {% if block.settings.footer_logo_6_url != blank %}
          <a href="{{ block.settings.footer_logo_6_url }}">
            {% endif %}
            <img class="footer-logo-width" src="{{ block.settings.footer_logo_6 | img_url: '300x300' }}"
                 data-src="{{ img_url }}"
                 data-widths="[360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                 data-aspectratio="{{ block.settings.footer_logo_6.aspect_ratio }}"
                 data-sizes="auto"
                 alt="{{ block.settings.footer_logo_6.alt | escape }}">
            {% if block.settings.footer_logo_6_url != blank %}
          </a>
          {% endif %}
        </div>
        {% endif %}
      </div>
    </div>

    {% when 'newsletter' %}
    <div class="grid__item medium-up--one-whole small--one-whole">
      <div class="sxrs-footo">
      {% if block.settings.title %}
      <h3 class="site-footer__section-title">{{ block.settings.title | escape }}</h3>
      {% endif %}
      <h3 class="site-footer__section-title">{{ 'general.newsletter_form.newsletter_heading' | t }}</h3>
      {% include 'newsletter', label: block.settings.subtext %}
    </div>
    </div>
    {% endcase %}
    {% endfor %}

  </div>

  {% if section.blocks.size > 0 %}
  <hr>
  {% endif %}


  <div class="footer_linklist">
    <div class="grid medium-up--grid--table sub-footer text-center">
      <div class="grid__item medium-up--one-whole">
        {%- assign footer_linklist = section.settings.footer_linklist -%}
        <ul class="site-footer__linklist list--inline">
          {%- for link in linklists[footer_linklist].links -%}
          <li class="site-footer__linklist-item">
            <a href="{{ link.url }}"
               {% if link.current %} aria-current="page"{% endif %}
               >
              {{ link.title | escape }}
            </a>
          </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
  <hr>
  <div class="grid medium-up--grid--table sub-footer small--text-center">


    <div class="grid__item medium-up--one-half">
      <small>{{ 'layout.footer.copyright' | t }} &copy; {{ 'now' | date: "%Y" }}, {{ shop.name | link_to: '/' }}. {{ powered_by_link }}</small>
    </div>
    {%- if section.settings.show_payment_icons -%}
    {%- unless shop.enabled_payment_types == empty -%}
    <div class="grid__item medium-up--one-half medium-up--text-right">
      <span class="visually-hidden">{{ 'general.payment.method' | t }}</span>
      <ul class="list--inline payment-icons">
        {%- for type in shop.enabled_payment_types -%}
        <li>
          {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
        </li>
        {%- endfor -%}
      </ul>
    </div>
    {%- endunless -%}
    {%- endif -%}
  </div>
</footer>


<style>
  .site-footer hr {
    margin: 10px 0;
  }
  .footer_linklist > .grid {
    padding: 0;
  }
  .footer_linklist > .grid ul{
    margin: 0;
  }
  .footer_linklist > .grid ul > .site-footer__linklist-item {
    padding-bottom: 0;
    line-height: 1;
  }


  .custom_social.grid {
    text-align: center;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
  }



  @media only screen and (min-device-width : 768px){ 

    .custom_social.grid > .one-half {
      width: 16%;
    }
  } 
  @media only screen and (min-device-width : 500px){ 

    .footer_linklist > .grid ul > .site-footer__linklist-item {
      width: 33%;
    }
  }

  @media only screen and (max-device-width : 767px){ 

    .custom_social.grid > .one-half {
      width: 33%;
    }
  }  


  @media only screen and (max-device-width : 449px){ 

    .custom_social.grid > .one-half {
      width: 50%;
    }
  } 


  @media only screen and (max-device-width : 499px){ 
    .footer_linklist > .grid ul > .site-footer__linklist-item {
      width: 100%;
    }
    .footer_linklist > .grid ul > .site-footer__linklist-item > a {
      font-size: 18px;
      margin: 8px 0;
      display: block;
    }
  }
</style>


