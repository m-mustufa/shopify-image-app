{% endif %}

   {% if section.settings.vendor_show %}
  <div class="product__vendor-pdp text-center">
    {% assign current_vendor = product.vendor | downcase %}

    {% for logo in shop.metaobjects.vendor_logo.values %}
      {% assign logo_vendor = logo.name | downcase %}
      {% if logo_vendor == current_vendor %}
        <img src="{{ logo.vendor_image | image_url }}" alt="{{ logo.name }}">
        {% break %}
      {% endif %}
    {% endfor %}
  </div>
{% endif %}

{% if section.settings.new_desc_box_position == 'under_vendor' %}
