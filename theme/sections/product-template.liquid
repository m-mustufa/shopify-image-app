          <link itemprop="availability" href="http://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}">
        <div class="product-price" style="display: flex;justify-content: space-between;">
          
          <p class="product-single__prices">
            {% if product.compare_at_price_max > product.price %}
              <span id="ComparePriceA11y" class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
            {% else %}
              <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
            {% endif %}
            {% if current_variant.price == 0 %}
            {% else %}
            <span id="ProductPrice" class="product-single__price" itemprop="price" content="{{ current_variant.price | divided_by: 100.00 }}">
              {{ current_variant.price | money }}
            </span>
            {% endif %}
            {% if product.compare_at_price_max > product.price %}
              <span id="PriceA11y" class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
              <s class="product-single__price--compare" id="ComparePrice">
                {{ current_variant.compare_at_price | money }}
              </s>
            {% endif %}
            </p>
            <div class="deal-live">
              {% render 'expired', product:product %}
            </div>
        </div>
    

        {% if section.settings.new_desc_box_position == 'under_price' %}
  {% render 'new-description-box', product: product %}
{% endif %}

{% if section.settings.coupon_position == 'under_price' %}
