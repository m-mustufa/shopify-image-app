</div>

<script>
(function() {
  var container = document.querySelector('.ss-share');
  if (!container) return;

  /* URL Shortening for Social Sharing */
  var urlShorteningDone = false;
  function updateShareUrlsWithShortLinks() {
    if (urlShorteningDone) return;
    var shareUrl = container.getAttribute('data-share-url');
    if (!shareUrl) return;{% if disable_shortener == true %}
    if (container.getAttribute('data-disable-shortener') === 'true') {
      urlShorteningDone = true;
      return;
    }{% endif %}
    
    console.log('Social sharing: Attempting to shorten URL:', shareUrl);
    console.log('URL_SHORTENER available:', typeof URL_SHORTENER !== 'undefined');
    
    // Generate cache key from product handle (not full URL) to avoid duplicates
    var cacheKey = shareUrl.split('/products/').pop().split('?')[0].split('#')[0].replace(/[^a-zA-Z0-9]/g, '_').substring(0, 50);
    
    // Shorten URL and update all share links
    if (typeof URL_SHORTENER !== 'undefined' && URL_SHORTENER.shortenUrl) {
      (async function() {
        try {
          const shortUrl = await URL_SHORTENER.shortenUrl(shareUrl, cacheKey);
          console.log('Social sharing: Got short URL:', shortUrl);
          
          // Update WhatsApp link — replace the long URL inside the message text with the short URL
          var whatsappLink = container.querySelector('a.ss-share__btn--whatsapp');
          if (whatsappLink) {
            var wMsg = decodeURIComponent(whatsappLink.getAttribute('href').split('text=')[1] || '');
            wMsg = wMsg.split(shareUrl).join(shortUrl);
            whatsappLink.setAttribute('href', 'https://api.whatsapp.com/send?text=' + encodeURIComponent(wMsg));
          }

          // Update Twitter/X link — same behavior as WhatsApp (message in text param)
          var twitterLink = container.querySelector('a.ss-share__btn--x');
          if (twitterLink) {
            var tMsg = decodeURIComponent(twitterLink.getAttribute('href').split('text=')[1] || '');
            tMsg = tMsg.split(shareUrl).join(shortUrl);
            twitterLink.setAttribute('href', 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(tMsg));
          }

          // Update Telegram link — same behavior as WhatsApp (message in text param only)
          var telegramLink = container.querySelector('a.ss-share__btn--telegram');
          if (telegramLink) {
            var tgMsg = decodeURIComponent(telegramLink.getAttribute('href').split('text=')[1] || '');
            tgMsg = tgMsg.split(shareUrl).join(shortUrl);
            telegramLink.setAttribute('href', 'https://t.me/share/url?text=' + encodeURIComponent(tgMsg));
          }

          // Update Facebook link — same behavior as WhatsApp (short URL in the message text)
          var facebookLink = container.querySelector('a.ss-share__btn--facebook');
          if (facebookLink) {
            var fbParams = new URLSearchParams(facebookLink.getAttribute('href').split('?')[1]);
            fbParams.set('u', shortUrl);
            var fbQuote = fbParams.get('quote');
            if (fbQuote) { fbParams.set('quote', fbQuote.split(shareUrl).join(shortUrl)); }
            facebookLink.setAttribute('href', 'https://www.facebook.com/sharer/sharer.php?' + fbParams.toString());
          }

          // Update Pinterest link — same behavior as WhatsApp (short URL in the message text)
          var pinterestLink = container.querySelector('a.ss-share__btn--pinterest');
          if (pinterestLink) {
            var pinParams = new URLSearchParams(pinterestLink.getAttribute('href').split('?')[1]);
            pinParams.set('url', shortUrl);
            var pinDesc = pinParams.get('description');
            if (pinDesc) { pinParams.set('description', pinDesc.split(shareUrl).join(shortUrl)); }
            pinterestLink.setAttribute('href', 'https://pinterest.com/pin/create/button/?' + pinParams.toString());
          }
          
          // Update LinkedIn link
          var linkedinLink = container.querySelector('a.ss-share__btn--linkedin');
          if (linkedinLink) {
            linkedinLink.setAttribute('href', 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(shortUrl));
          }
          
          // Update copy link button
          var copyBtn = container.querySelector('[data-copy-url]');
          if (copyBtn) {
            copyBtn.setAttribute('data-copy-url', shortUrl);
          }
          
          // Update native share API
          var nativeBtn = container.querySelector('[data-native-share]');
          if (nativeBtn) {
            nativeBtn.setAttribute('data-share-url', shortUrl);
          }

          urlShorteningDone = true;
        } catch (error) {
          console.error('Social sharing URL shortening failed:', error);
        }
      })();
    }
  }

  /* Modal functionality */
  var modal = container.querySelector('[data-modal]');
  var openBtn = container.querySelector('[data-open-modal]');
  var closeBtns = container.querySelectorAll('[data-close-modal]');

  function openModal() {
    if (modal) {
      modal.classList.add('ss-share__modal--open');
      document.body.style.overflow = 'hidden';
      {% unless disable_shortener == true %}
      // Update URLs when modal opens - add small delay to ensure URL_SHORTENER is available
      setTimeout(function() {
        updateShareUrlsWithShortLinks();
      }, 100);
      {% endunless %}
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.remove('ss-share__modal--open');
      document.body.style.overflow = '';
    }
  }

  if (openBtn && modal) {
    openBtn.addEventListener('click', openModal);
  }

  for (var i = 0; i < closeBtns.length; i++) {
    closeBtns[i].addEventListener('click', closeModal);
  }

  /* Close modal on overlay click */
  var overlay = container.querySelector('.ss-share__modal-overlay');
  if (overlay) {
    overlay.addEventListener('click', closeModal);
  }

  /* Close modal on escape key */
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal && modal.classList.contains('ss-share__modal--open')) {
      closeModal();
    }
  });

  /* Web Share API — show native share button on supported devices */
  if (navigator.share) {
    var nativeBtn = container.querySelector('[data-native-share]');
    if (nativeBtn) {
      nativeBtn.style.display = '';
      nativeBtn.addEventListener('click', function() {
        navigator.share({
          title: container.getAttribute('data-share-title'),
          url: nativeBtn.getAttribute('data-share-url') || container.getAttribute('data-share-url')
        }).catch(function() {});
      });
    }
  }

  /* Copy link */
  var copyBtns = container.querySelectorAll('[data-copy-url]');
  for (var i = 0; i < copyBtns.length; i++) {
    (function(copyBtn) {
      copyBtn.addEventListener('click', function() {
        var url = this.getAttribute('data-copy-url');
        var originalHTML = this.innerHTML;
        
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(function() {
            copyBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>';
            setTimeout(function(){ copyBtn.innerHTML = originalHTML; }, 2000);
          });
        } else {
          var ta = document.createElement('textarea');
          ta.value = url; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select();
          try { 
            document.execCommand('copy'); 
            copyBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>';
            setTimeout(function(){ copyBtn.innerHTML = originalHTML; }, 2000);
          } catch(e) {}
          document.body.removeChild(ta);
        }
      });
    })(copyBtns[i]);
  }

  /* Open share links in centered popup */
  var links = container.querySelectorAll('a.ss-share__btn');
  for (var i = 0; i < links.length; i++) {
    (function(link) {
      if (link.getAttribute('href') && link.getAttribute('href').indexOf('mailto:') !== 0) {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          var w = 600, h = 400;
          var left = (screen.width - w) / 2, top = (screen.height - h) / 2;
          window.open(this.href, 'share', 'width=' + w + ',height=' + h + ',left=' + left + ',top=' + top + ',toolbar=no,menubar=no,scrollbars=yes,resizable=yes');
        });
      }
    })(links[i]);
  }

  /* Update main button URLs on page load */
  setTimeout(function() {
    updateShareUrlsWithShortLinks();
  }, 500);
})();
</script>

<style>
.ss-share {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* Main buttons layout */
.ss-share__buttons--main {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 0;
}

/* Base button styles */
.ss-share__btn {
  display: inline-flex;
