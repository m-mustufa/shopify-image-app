{% doc %}
  @prompt
    An interactive vertical timeline that highlights as the user scrolls
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-timeline-wrapper-{{ ai_gen_id }} {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
  }

  .ai-timeline-line-{{ ai_gen_id }} {
    position: absolute;
    left: 30px;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: {{ block.settings.line_color }};
  }

  .ai-timeline-progress-{{ ai_gen_id }} {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 0%;
    background-color: {{ block.settings.active_line_color }};
    transition: height 0.3s ease;
  }

  .ai-timeline-item-{{ ai_gen_id }} {
    position: relative;
    padding-left: 80px;
    margin-bottom: 60px;
    opacity: 0.4;
    transition: opacity 0.3s ease;
  }

  .ai-timeline-item-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-timeline-dot-{{ ai_gen_id }} {
    position: absolute;
    left: 20px;
    top: 5px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: {{ block.settings.line_color }};
    border: 3px solid {{ block.settings.background_color }};
    transition: all 0.3s ease;
    z-index: 2;
  }

  .ai-timeline-item-{{ ai_gen_id }}.active .ai-timeline-dot-{{ ai_gen_id }} {
    background-color: {{ block.settings.active_line_color }};
    transform: scale(1.3);
    box-shadow: 0 0 0 4px {{ block.settings.active_line_color }}33;
  }

  .ai-timeline-content-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    padding: 24px;
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-timeline-date-{{ ai_gen_id }} {
    font-size: {{ block.settings.date_font_size }}px;
    color: {{ block.settings.date_color }};
    margin-bottom: 8px;
    font-weight: 600;
  }

  .ai-timeline-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    font-weight: 700;
  }

  .ai-timeline-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-timeline-container-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-timeline-item-{{ ai_gen_id }} {
      padding-left: 60px;
      margin-bottom: 40px;
    }

    .ai-timeline-line-{{ ai_gen_id }} {
      left: 20px;
    }

    .ai-timeline-dot-{{ ai_gen_id }} {
      left: 11px;
      width: 18px;
      height: 18px;
    }

    .ai-timeline-content-{{ ai_gen_id }} {
      padding: 18px;
    }
  }
{% endstyle %}

<scroll-timeline-{{ ai_gen_id }}
  class="ai-timeline-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-timeline-wrapper-{{ ai_gen_id }}">
    <div class="ai-timeline-line-{{ ai_gen_id }}">
      <div class="ai-timeline-progress-{{ ai_gen_id }}"></div>
    </div>

    {% for i in (1..5) %}
      {% liquid
        assign date_key = 'item_' | append: i | append: '_date'
        assign title_key = 'item_' | append: i | append: '_title'
        assign description_key = 'item_' | append: i | append: '_description'

        assign item_date = block.settings[date_key]
        assign item_title = block.settings[title_key]
        assign item_description = block.settings[description_key]
      %}

      {% if item_title != blank or item_description != blank %}
        <div
          class="ai-timeline-item-{{ ai_gen_id }}"
          data-timeline-item="{{ i }}"
        >
          <div class="ai-timeline-dot-{{ ai_gen_id }}"></div>
          <div class="ai-timeline-content-{{ ai_gen_id }}">
            {% if item_date != blank %}
              <div class="ai-timeline-date-{{ ai_gen_id }}">{{ item_date }}</div>
            {% endif %}
            {% if item_title != blank %}
              <h3 class="ai-timeline-title-{{ ai_gen_id }}">{{ item_title }}</h3>
            {% endif %}
            {% if item_description != blank %}
              <div class="ai-timeline-description-{{ ai_gen_id }}">
                {{ item_description }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</scroll-timeline-{{ ai_gen_id }}>

<script>
  (function() {
    class ScrollTimeline{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.items = [];
        this.progressBar = null;
        this.timelineWrapper = null;
      }

      connectedCallback() {
        this.items = Array.from(this.querySelectorAll('.ai-timeline-item-{{ ai_gen_id }}'));
        this.progressBar = this.querySelector('.ai-timeline-progress-{{ ai_gen_id }}');
        this.timelineWrapper = this.querySelector('.ai-timeline-wrapper-{{ ai_gen_id }}');

        if (this.items.length === 0) return;

        this.setupScrollListener();
        this.updateTimeline();
      }

      setupScrollListener() {
        let ticking = false;

        window.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              this.updateTimeline();
              ticking = false;
            });
            ticking = true;
          }
        });
      }

      updateTimeline() {
        const windowHeight = window.innerHeight;
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const timelineTop = this.timelineWrapper.offsetTop;
        const timelineHeight = this.timelineWrapper.offsetHeight;

        let activeIndex = -1;
        let maxProgress = 0;

        this.items.forEach((item, index) => {
          const itemTop = item.offsetTop + timelineTop;
          const itemMiddle = itemTop + (item.offsetHeight / 2);
          const viewportMiddle = scrollTop + (windowHeight / 2);

          if (viewportMiddle >= itemMiddle) {
            activeIndex = index;
            item.classList.add('active');

            const itemBottom = itemTop + item.offsetHeight;
            const relativeProgress = ((itemBottom - timelineTop) / timelineHeight) * 100;
            maxProgress = Math.min(relativeProgress, 100);
          } else {
            item.classList.remove('active');
          }
        });

        if (this.progressBar) {
          this.progressBar.style.height = maxProgress + '%';
        }
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.updateTimeline);
      }
    }

    customElements.define('scroll-timeline-{{ ai_gen_id }}', ScrollTimeline{{ ai_gen_id }});
  })();
</script>

